# ~/.zprofile_cfg — Zsh login shell configuration
# Sourced from ~/.zprofile via a line added by .install/install_config.sh
# Section order mirrors .bash_profile_cfg.

# ──────────────────────────────────────────────────────
# macOS: Homebrew (only when running on macOS)
# Must come first so brew-installed tools (starship,
# keychain, ...) are on PATH for everything below.
# ──────────────────────────────────────────────────────

if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ──────────────────────────────────────────────────────
# Pyenv — login-shell PATH setup
# Must come before .zshrc so pyenv shims are on PATH
# when .zshrc runs `pyenv init`.
# ──────────────────────────────────────────────────────

export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"

# ──────────────────────────────────────────────────────
# PATH
# ──────────────────────────────────────────────────────

[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"
