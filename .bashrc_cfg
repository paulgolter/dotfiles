# ~/.bashrc_cfg — Bash-specific interactive shell configuration
# Sourced from ~/.bashrc via a line added by .install/install_config.sh
# Shared config (aliases, functions, PATH, keychain) lives in .shellrc_cfg
# Section order mirrors .zshrc_cfg.

# Only run for interactive shells
[[ $- != *i* ]] && return

# ──────────────────────────────────────────────────────
# SHARED CONFIG
# ──────────────────────────────────────────────────────

[[ -f "$HOME/.shellrc_cfg" ]] && source "$HOME/.shellrc_cfg"

# ──────────────────────────────────────────────────────
# KEY BINDINGS (bash-specific)
# ──────────────────────────────────────────────────────

# Ctrl+F: accept the next character of the current suggestion (like fish)
bind '"\C-f": forward-char'

# ──────────────────────────────────────────────────────
# TOOL INITIALISATION (bash-specific)
# ──────────────────────────────────────────────────────

# Pyenv
if command -v pyenv &>/dev/null; then
    eval "$(pyenv init - bash)"
fi

# Starship prompt
if command -v starship &>/dev/null; then
    eval "$(starship init bash)"
fi
