# ~/.zshrc_cfg — Zsh-specific interactive shell configuration
# Sourced from ~/.zshrc via a line added by .install/install_config.sh
# Shared config (aliases, functions, PATH, keychain) lives in .shellrc_cfg
# Section order mirrors .bashrc_cfg.

# ──────────────────────────────────────────────────────
# SHARED CONFIG
# ──────────────────────────────────────────────────────

[[ -f "$HOME/.shellrc_cfg" ]] && source "$HOME/.shellrc_cfg"

# ──────────────────────────────────────────────────────
# KEY BINDINGS (zsh-specific)
# ──────────────────────────────────────────────────────

# Ctrl+F: accept the next character of the current suggestion (like fish)
bindkey '\C-f' forward-char

# ──────────────────────────────────────────────────────
# TOOL INITIALISATION (zsh-specific)
# ──────────────────────────────────────────────────────

# Pyenv
if command -v pyenv &>/dev/null; then
    eval "$(pyenv init - zsh)"
fi

# Starship prompt
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi
